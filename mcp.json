{
  "mcpServers": {
    "ghidra": {
      "command": "python3",
      "args": ["-m", "ghidra_mcp"],
      "env": {
        "JAVA_HOME": "/home/appuser/tools/jdk-25",
        "GHIDRA_INSTALL_DIR": "/home/appuser/tools/ghidra_12.2_PUBLIC"
      }
    },
    "rea": {
      "command": "rea",
      "args": ["mcp"],
      "env": {
        "PATH": "/home/appuser/.npm-global/bin:/home/appuser/.local/bin:/home/appuser/tools/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "x64dbg": {
      "command": "/home/appuser/tools/bin/x64dbg-headless",
      "args": []
    },
    "netcoredbg": {
      "command": "/home/appuser/tools/netcoredbg/netcoredbg",
      "args": ["--server"],
      "env": {
        "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "1"
      }
    },
    "bla": {
      "command": "bla",
      "args": ["mcp"],
      "env": {
        "PATH": "/home/appuser/.npm-global/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
