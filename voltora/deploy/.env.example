# VOLTORA deployment environment. Copy to deploy/.env (git-ignored) and replace every CHANGE_ME.
# Nothing in this file is a real secret. Generate values with the commands shown; never reuse them across environments.

# Public hostname served by Caddy (no scheme). `localhost` gives a local self-signed certificate.
SITE_ADDRESS=shop.example.com
ACME_EMAIL=you@example.com

# Database password for the bundled PostgreSQL container.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME

# Session/CSRF/HMAC secret, >= 32 random characters (the API refuses to start in production without it).
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VOLTORA_SECRET_KEY=CHANGE_ME

# Vault key sealing stored credentials (payment/courier/AI keys) AND deriving the backup encryption key.
# A Fernet key: 32 url-safe base64 bytes. LOSING IT MAKES SEALED SECRETS AND ENCRYPTED BACKUPS UNRECOVERABLE.
# Store a copy in your password manager, separate from backups.
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
VOLTORA_VAULT_KEY=CHANGE_ME

# Providers stay in sandbox and external network calls stay off until you verify each integration in the admin UI.
VOLTORA_PAYMENTS_MODE=sandbox
VOLTORA_EXTERNAL_NETWORK=false

# Optional CSP additions for the edge (space-separated origins), e.g. a CAPTCHA widget:
#   hCaptcha:   CSP_SCRIPT_SRC_EXTRA=https://js.hcaptcha.com   CSP_FRAME_SRC_EXTRA=https://*.hcaptcha.com   CSP_CONNECT_SRC_EXTRA=https://hcaptcha.com
#   Turnstile:  CSP_SCRIPT_SRC_EXTRA=https://challenges.cloudflare.com   CSP_FRAME_SRC_EXTRA=https://challenges.cloudflare.com
CSP_SCRIPT_SRC_EXTRA=
CSP_FRAME_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=

# Image tag (useful for rollback: keep the previous tag around).
VOLTORA_IMAGE_TAG=local
