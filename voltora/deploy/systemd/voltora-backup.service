[Unit]
Description=VOLTORA encrypted backup with restore drill
After=postgresql.service

[Service]
Type=oneshot
User=voltora
Group=voltora
WorkingDirectory=/opt/voltora/current/backend
EnvironmentFile=/etc/voltora/voltora.env
ExecStart=/opt/voltora/current/backend/.venv/bin/python -m app.modules.ops.backup create --encrypt
ExecStart=/opt/voltora/current/backend/.venv/bin/python -m app.modules.ops.backup verify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/voltora
